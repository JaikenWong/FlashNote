/* 全局样式 · 与 DESIGN.md §6 对齐 */

page {
  --c-green: #52C41A;
  --c-green-soft: #F6FFED;
  --c-green-deep: #389E0D;
  --c-green-faint: #E8F5D8;
  --c-warn: #FAAD14;
  --c-warn-soft: #FFF7E6;
  --c-text-1: #1F1F1F;
  --c-text-2: #595959;
  --c-text-3: #8C8C8C;
  --c-text-4: #BFBFBF;
  --c-border: #F0F0F0;
  --c-border-2: #E8E8E8;
  --c-page: #FAFAFA;

  --r-card: 24rpx;
  --r-btn:  16rpx;
  --r-chip: 12rpx;

  background: var(--c-page);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--c-text-1);
  font-size: 28rpx;
  line-height: 1.5;
}

/* 通用容器 */
.container {
  padding: 20rpx 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: var(--r-card);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.02);
}
.card::before {
  content: '';
  position: absolute;
  left: 0; top: 16rpx; bottom: 16rpx;
  width: 6rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: var(--c-green);
}
.card.expense::before {
  background: transparent;
  border: none;
  width: 0;
}
.card.expense {
  padding-left: 32rpx;
}
.card.expense::after {
  content: '';
  position: absolute;
  left: 14rpx; top: 20rpx; bottom: 20rpx;
  width: 6rpx;
  border-radius: 4rpx;
  background: repeating-linear-gradient(
    to bottom,
    var(--c-warn) 0 8rpx,
    transparent 8rpx 14rpx
  );
}
.card .text {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--c-text-1);
  margin-bottom: 12rpx;
}
.card .meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--c-text-3);
}
.card .amount {
  color: var(--c-warn);
  font-weight: 600;
  font-size: 26rpx;
}

/* 标签 chip */
.tag-chip {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  background: var(--c-green-soft);
  color: var(--c-green-deep);
  border-radius: var(--r-chip);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 32rpx;
}
.tag-chip.warm {
  background: var(--c-warn-soft);
  color: #D48806;
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  background: var(--c-green);
  color: #fff;
  border-radius: var(--r-btn);
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}
.btn::after { border: none; }
.btn.outline {
  background: #fff;
  color: var(--c-text-1);
  border: 1rpx solid var(--c-border-2);
}
.btn.ghost {
  background: transparent;
  color: var(--c-green-deep);
}

/* 同步状态 */
.sync-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--c-text-2);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--c-green-soft);
  color: var(--c-green-deep);
  font-weight: 500;
}
.sync-pill .dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--c-green);
}
.sync-pill.idle {
  background: #f5f5f5;
  color: var(--c-text-3);
}
.sync-pill.idle .dot {
  background: var(--c-text-4);
}

/* 文本工具 */
.muted { color: var(--c-text-3); }
.tiny  { font-size: 22rpx; }
.mono  { font-family: "SF Mono", monospace; }

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  color: var(--c-text-3);
}
.empty .emoji { font-size: 96rpx; margin-bottom: 24rpx; }
.empty .hint  { font-size: 24rpx; color: var(--c-text-4); margin-top: 8rpx; }

/* 月份分组标题 */
.day-head {
  font-size: 22rpx;
  color: var(--c-text-3);
  font-weight: 500;
  margin: 20rpx 8rpx 16rpx;
}
.day-head .sum {
  margin-left: 8rpx;
  color: var(--c-text-2);
}
.day-head .sum .v {
  color: var(--c-green-deep);
  font-weight: 600;
}
