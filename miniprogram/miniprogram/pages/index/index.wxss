.page {
  min-height: 100vh;
  padding-bottom: 200rpx;
  background: var(--c-page);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
  background: #fff;
}
.topbar .title {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.list {
  padding: 16rpx 24rpx 0;
}

/* 底部输入条 */
.quick-input {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 120rpx;  /* tabbar 上面 */
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}
.quick-input .preview {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  min-height: 32rpx;
}
.quick-input .preview .amount {
  color: var(--c-warn);
  font-weight: 600;
  font-size: 24rpx;
}
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.input {
  flex: 1;
  font-size: 28rpx;
  height: 44rpx;
  line-height: 44rpx;
}
.send {
  width: 56rpx;
  height: 56rpx;
  background: var(--c-green);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(82, 196, 26, 0.32);
}
.send-icon {
  color: #fff;
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
}

/* 浮层 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 200rpx;
}
.modal {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.16);
}
.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.modal-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 30rpx;
  line-height: 1.6;
  padding: 20rpx;
  background: var(--c-page);
  border-radius: 16rpx;
  box-sizing: border-box;
}
.modal-preview {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
}
.modal-preview .amount {
  color: var(--c-warn);
  font-weight: 600;
  font-size: 24rpx;
}
.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}
