.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 200rpx;
  background: var(--c-page);
}
.header {
  padding: 16rpx 8rpx;
}
.header .label {
  font-size: 22rpx;
  color: var(--c-text-3);
}
.header .month {
  font-size: 28rpx;
  color: var(--c-text-2);
  margin-top: 4rpx;
}

.hero {
  background: linear-gradient(135deg, #52C41A 0%, #389E0D 100%);
  color: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: '';
  position: absolute;
  right: -40rpx; top: -40rpx;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}
.hero .amount {
  font-size: 36rpx;
  font-weight: 400;
  opacity: 0.95;
}
.hero .amount .big {
  font-size: 72rpx;
  font-weight: 600;
  margin-left: 4rpx;
}
.hero .compare {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.card-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--c-text-2);
  margin-bottom: 20rpx;
}
.empty-mini {
  font-size: 24rpx;
  color: var(--c-text-3);
  text-align: center;
  padding: 32rpx 0;
}

.cat {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}
.cat:last-child { margin-bottom: 0; }
.cat-name {
  width: 120rpx;
  color: var(--c-text-2);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cat-bar {
  flex: 1;
  height: 12rpx;
  background: var(--c-page);
  border-radius: 6rpx;
  overflow: hidden;
}
.cat-bar .bar {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}
.cat-amount {
  width: 120rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
  color: var(--c-text-2);
}

.week {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  height: 200rpx;
  padding: 16rpx 8rpx 0;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  height: 100%;
  justify-content: flex-end;
}
.bar-col .bar {
  width: 100%;
  max-width: 48rpx;
  border-radius: 8rpx;
  min-height: 4rpx;
}
.bar-col .bar-label {
  font-size: 20rpx;
  color: var(--c-text-3);
}
