.page {
  min-height: 100vh;
  padding-bottom: 200rpx;
  background: var(--c-page);
}

.profile {
  background: #fff;
  padding: 32rpx 28rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  background: var(--c-green-soft);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.info {
  flex: 1;
  min-width: 0;
}
.info .name {
  font-size: 32rpx;
  font-weight: 500;
}
.info .device-id {
  font-size: 22rpx;
  color: var(--c-text-3);
  font-family: "SF Mono", monospace;
  margin-top: 4rpx;
}
.info .device-info {
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-top: 4rpx;
}

.pair-card {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  border: 2rpx solid var(--c-green-faint);
}
.pair-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--c-text-1);
  margin-bottom: 16rpx;
}
.pair-row {
  display: flex;
  align-items: center;
}
.pair-info { flex: 1; }
.pair-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--c-green-deep);
}
.pair-sub {
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-top: 4rpx;
  font-family: "SF Mono", monospace;
}
.pair-pill {
  background: var(--c-green-soft);
  color: var(--c-green-deep);
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.pair-tip {
  font-size: 24rpx;
  color: var(--c-text-3);
  text-align: center;
  margin-bottom: 20rpx;
  line-height: 1.6;
}
.pair-loading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  color: var(--c-text-2);
  font-size: 24rpx;
}
.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--c-green-soft);
  border-top-color: var(--c-green);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.form-label {
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-bottom: 8rpx;
}
.input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--c-page);
  border: 2rpx solid var(--c-border);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.code-input {
  font-size: 36rpx;
  text-align: center;
  letter-spacing: 8rpx;
  font-family: "SF Mono", monospace;
  font-weight: 600;
  color: var(--c-green-deep);
}
.host-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.host-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--c-page);
  border: 2rpx solid var(--c-border);
  border-radius: 12rpx;
}
.host-item.selected {
  border-color: var(--c-green);
  background: var(--c-green-soft);
}
.host-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--c-text-1);
}
.host-ip {
  font-size: 22rpx;
  color: var(--c-text-3);
  font-family: "SF Mono", monospace;
}
.form-error {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #FFF1F0;
  border-radius: 8rpx;
  color: #CF1322;
  font-size: 22rpx;
}
.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  justify-content: flex-end;
}
.btn.primary {
  background: var(--c-green);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border: none;
  flex: 1;
}
.btn.outline {
  background: #fff;
  color: var(--c-text-1);
  border: 2rpx solid var(--c-border-2);
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
}
.btn.ghost {
  background: transparent;
  color: var(--c-text-3);
  font-size: 28rpx;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
}

.cells {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--c-border);
  font-size: 28rpx;
}
.cell:last-child { border-bottom: none; }
.cell-icon {
  width: 48rpx;
  height: 48rpx;
  background: var(--c-green-soft);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.cell-text {
  flex: 1;
  color: var(--c-text-1);
}
.cell-arrow {
  color: var(--c-text-3);
  font-size: 32rpx;
  font-weight: 300;
}
.cell-meta {
  font-size: 24rpx;
  color: var(--c-text-4);
}
