<view class="page">
  <!-- 头部：用户 + 设备信息 -->
  <view class="profile">
    <image class="avatar" src="/images/logo.png" mode="aspectFit"></image>
    <view class="info">
      <view class="name">闪记</view>
      <view class="device-id">device-id: {{deviceId}}</view>
      <view class="device-info">{{deviceInfo}} · {{recordCount}} 条记录</view>
    </view>
  </view>

  <!-- 配对卡片（多种状态） -->
  <view class="pair-card">
    <view class="pair-title">局域网同步</view>

    <!-- idle：未配对 -->
    <view wx:if="{{pairStep === 'idle'}}">
      <view class="pair-tip">需与 Mac 在同一 WiFi 下，Mac 端会显示 4 位配对码</view>
      <view class="btn primary" bindtap="onStartPair">开始配对</view>
    </view>

    <!-- scanning -->
    <view wx:elif="{{pairStep === 'scanning'}}" class="pair-loading">
      <view class="spinner"></view>
      <text>正在扫描局域网内的 Mac…</text>
    </view>

    <!-- entering：选 host + 输入 code -->
    <view wx:elif="{{pairStep === 'entering' || pairStep === 'error'}}">
      <view class="form-label">选择或输入 Mac IP</view>
      <view class="host-list" wx:if="{{discoveredHosts.length > 0}}">
        <view
          wx:for="{{discoveredHosts}}"
          wx:key="ip"
          class="host-item {{pairHost === item.ip ? 'selected' : ''}}"
          bindtap="onSelectHost"
          data-host="{{item.ip}}"
        >
          <view class="host-name">{{item.name || 'Mac'}}</view>
          <view class="host-ip">{{item.ip}}:{{item.port}}</view>
        </view>
      </view>
      <input
        class="input"
        placeholder="或手动输入 IP，如 192.168.1.42"
        value="{{pairHost}}"
        bindinput="onInputHost"
      />

      <view class="form-label" style="margin-top: 24rpx;">配对码（4 位）</view>
      <view class="code-inputs">
        <input
          class="input code-input"
          type="number"
          maxlength="4"
          value="{{pairCode}}"
          bindinput="onInputCode"
          placeholder="____"
        />
      </view>

      <view class="form-error" wx:if="{{pairError}}">{{pairError}}</view>

      <view class="form-actions">
        <view class="btn outline" bindtap="onCancelPair">取消</view>
        <view class="btn primary" bindtap="onConfirmPair">连接</view>
      </view>
    </view>

    <!-- pairing -->
    <view wx:elif="{{pairStep === 'pairing'}}" class="pair-loading">
      <view class="spinner"></view>
      <text>正在配对…</text>
    </view>

    <!-- paired：已连接 -->
    <view wx:elif="{{pairStep === 'paired'}}">
      <view class="pair-row">
        <view class="pair-info">
          <view class="pair-label">已连接 Mac</view>
          <view class="pair-sub">{{pairHost}} · {{lastSyncText}}</view>
        </view>
        <view class="pair-pill">已连接</view>
      </view>
      <view class="form-actions">
        <view class="btn outline" bindtap="doSync" wx:if="{{syncState !== 'syncing'}}">立即同步</view>
        <view class="btn outline" wx:else>同步中…</view>
        <view class="btn ghost" bindtap="onUnpair">断开</view>
      </view>
    </view>
  </view>

  <!-- 设置列表 -->
  <view class="cells">
    <view class="cell" bindtap="onExport">
      <view class="cell-icon">📤</view>
      <view class="cell-text">导出数据（Markdown）</view>
      <view class="cell-arrow">›</view>
    </view>
    <view class="cell">
      <view class="cell-icon">🎨</view>
      <view class="cell-text">外观</view>
      <view class="cell-arrow">›</view>
    </view>
    <view class="cell">
      <view class="cell-icon">ℹ️</view>
      <view class="cell-text">关于闪记</view>
      <view class="cell-arrow cell-meta">v0.1.0 ›</view>
    </view>
  </view>
</view>
